# Base URL for an OpenAI-compatible API.
# For DSPy gateway, this resolves to: http://localhost:${DSPY_GATEWAY_PORT}
VITE_AI_API_URL=http://localhost:${DSPY_GATEWAY_PORT}
# API key for the provider or gateway token (required by UI; can be any non-empty value if gateway auth is disabled)
VITE_AI_API_KEY=
# Shared model identifier used by both UI and DSPy gateway (provider/model)
VITE_AI_MODEL=
# API key used by DSPy LM (or set OPENAI_API_KEY)
DSPY_API_KEY=
# Optional API base URL for OpenAI-compatible providers
DSPY_API_BASE=
# Deterministic generation defaults
DSPY_TEMPERATURE=0
DSPY_MAX_TOKENS=220
# Optional request timeout in seconds for DSPy -> provider call
DSPY_TIMEOUT_SECONDS=20
# Gateway listen port
DSPY_GATEWAY_PORT=8001
# Optional: if set, incoming Bearer token must match this value
DSPY_GATEWAY_API_KEY=
