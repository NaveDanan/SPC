# =========================
# Frontend (SPA) AI config
# =========================
# API base the frontend calls.
# - Gateway mode: http://localhost:8001 (recommended)
# - Direct provider mode: your provider's OpenAI-compatible base URL
AI_API_URL=http://localhost:8001

# Bearer token sent by frontend and used by gateway for upstream provider calls.
AI_API_KEY=

# Model identifier used by frontend and DSPy gateway (example: provider/model)
AI_MODEL=

# ==================================
# DSPy -> upstream provider settings
# ==================================
# Optional: set only when gateway calls a custom OpenAI-compatible upstream base URL.
# Leave empty to use provider default resolution from model name.
AI_API_BASE=

# DSPy provider call settings
DSPY_TEMPERATURE=0
DSPY_MAX_TOKENS=220
# Optional request timeout in seconds for DSPy -> provider call
DSPY_TIMEOUT_SECONDS=20

# Optional: override gateway listen port (default: 8001)
AI_GATEWAY_PORT=8001
